# Copia este archivo como ".env" y ajusta los valores.
# El .env real nunca se sube a git.

# 1 = desarrollo (muestra errores detallados). 0 = despliegue.
DJANGO_DEBUG=1

# Obligatoria cuando DJANGO_DEBUG=0. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Dominios desde los que se puede abrir el sitio, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
